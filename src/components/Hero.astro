---
---

<section class="hero">
  <div class="hero-bg-shapes">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
  </div>
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        Trusted Dental Care in O'Fallon, IL
      </div>
      <h1 class="hero-title">
        Your Smile Is Our <span class="text-gradient">Greatest Priority</span>
      </h1>
      <p class="hero-description">
        From preventive care to advanced treatments, we offer a full range of dental services designed to keep your smile healthy and confident. Experience compassionate care that puts your comfort first.
      </p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary btn-lg">
          Schedule a Visit
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="#services" class="btn btn-outline btn-lg">
          Explore Services
        </a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-number">25+</span>
          <span class="stat-label">Years of Experience</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-number">10k+</span>
          <span class="stat-label">Happy Patients</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-number">15+</span>
          <span class="stat-label">Dental Services</span>
        </div>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-image-wrapper">
        <div class="hero-image-card">
          <div class="hero-image-placeholder">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#4BA69D" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2C8 2 5 5 5 8.5C5 11.5 6.5 13.5 8.5 15.5C10.5 17.5 10 20 10 22H14C14 20 13.5 17.5 15.5 15.5C17.5 13.5 19 11.5 19 8.5C19 5 16 2 12 2Z"/>
              <line x1="9" y1="22" x2="15" y2="22"/>
              <line x1="10" y1="24" x2="14" y2="24"/>
            </svg>
            <p>Healthy Smiles Start Here</p>
          </div>
        </div>
        <div class="hero-float-card card-top">
          <div class="float-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4BA69D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          </div>
          <div>
            <strong>Trusted Care</strong>
            <span>4.9 Star Rating</span>
          </div>
        </div>
        <div class="hero-float-card card-bottom">
          <div class="float-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4BA69D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div>
            <strong>Flexible Hours</strong>
            <span>Mon - Fri Available</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
